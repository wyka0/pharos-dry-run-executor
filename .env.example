# Dry-Run Executor — Pharos Atlantic Testnet configuration
# Copy this file to .env and adjust if needed. Defaults match the public
# Pharos Atlantic Testnet endpoint.
#
# SAFETY: this project is simulation-only. It never signs or broadcasts
# transactions, so it never needs a private key. Do not add one here.

# Read-only JSON-RPC endpoint used for eth_call / eth_estimateGas /
# eth_getBalance / eth_gasPrice.
PHAROS_RPC_URL=https://atlantic.dplabs-internal.com

# Expected chain ID. The executor verifies the RPC-reported chain ID against
# this value before simulating and fails closed on mismatch.
PHAROS_CHAIN_ID=688689

# Human-readable chain name shown in reports.
PHAROS_CHAIN_NAME=Pharos Atlantic Testnet

# Block explorer (shown in reports only; the executor never talks to it).
PHAROS_EXPLORER_URL=https://atlantic.pharosscan.xyz
